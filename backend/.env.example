PORT=3000
# Kendi PostgreSQL kullanıcı adı/şifrenizi yazın. Veritabanı yoksa `npm run setup` oluşturur.
DATABASE_URL="postgresql://postgres:SIFRENIZ@localhost:5432/ikametgah?schema=public"
JWT_SECRET="degistir-beni-uzun-rastgele-bir-deger"
JWT_EXPIRES_IN="8h"
# QR koddaki doğrulama bağlantısı bu adresle oluşturulur
PUBLIC_URL="http://localhost:3000"
# Haritada işaretlenen nokta ile bina koordinatı arasındaki izin verilen en büyük mesafe (metre)
MAX_KONUM_SAPMASI_M=150
